{%- comment -%}
  Newsletter signup that creates a customer tagged "newsletter".
  - form_id: unique id
  - inverse: true when on a dark background
{%- endcomment -%}
{%- form 'customer', id: form_id, class: 'newsletter-form' -%}
  <input type="hidden" name="contact[tags]" value="newsletter">
  {%- if form.posted_successfully? -%}
    <p class="form-message form-message--success" role="status" tabindex="-1" autofocus>
      {% render 'icon', name: 'check' %}
      {{ 'newsletter.success' | t }}
    </p>
  {%- else -%}
    <div class="newsletter-form__field{% if inverse %} newsletter-form__field--inverse{% endif %}">
      <label class="visually-hidden" for="{{ form_id }}-email">{{ 'newsletter.label' | t }}</label>
      <input
        id="{{ form_id }}-email"
        type="email"
        name="contact[email]"
        class="newsletter-form__input"
        value="{{ form.email }}"
        autocomplete="email"
        autocorrect="off"
        autocapitalize="off"
        placeholder="{{ 'newsletter.label' | t }}"
        required
        {% if form.errors %}aria-invalid="true" aria-describedby="{{ form_id }}-error"{% endif %}
      >
      <button type="submit" class="newsletter-form__button" name="commit">
        <span class="visually-hidden">{{ 'newsletter.button' | t }}</span>
        {% render 'icon', name: 'arrow' %}
      </button>
    </div>
    {%- if form.errors -%}
      <p id="{{ form_id }}-error" class="form-message form-message--error">{{ form.errors.translated_fields.email | capitalize }} {{ form.errors.messages.email }}</p>
    {%- endif -%}
  {%- endif -%}
{%- endform -%}
