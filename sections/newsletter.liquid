<section class="section newsletter color-{{ section.settings.color_scheme }}">
  <div class="page-width page-width--narrow newsletter__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="h1">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <div class="rte newsletter__text">{{ section.settings.text }}</div>
    {%- endif -%}
    {%- assign inverse = false -%}
    {%- if section.settings.color_scheme == 'inverse' -%}{%- assign inverse = true -%}{%- endif -%}
    {% render 'newsletter-form', form_id: 'NewsletterSection', inverse: inverse %}
  </div>
</section>

{% schema %}
{
  "name": "Newsletter",
  "class": "section-newsletter",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Join the collective"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Be first to know about new drops and restocks.</p>"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colors",
      "options": [
        { "value": "default", "label": "Light" },
        { "value": "inverse", "label": "Dark" }
      ],
      "default": "default"
    }
  ],
  "presets": [
    {
      "name": "Newsletter"
    }
  ]
}
{% endschema %}
