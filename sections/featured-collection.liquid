{%- liquid
  assign collection = section.settings.collection
  assign limit = section.settings.products_to_show
  assign products = collection.products
  if collection == blank
    assign products = collections.all.products
  endif
-%}

<section class="section featured-collection color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="section-heading">
      {%- if section.settings.heading != blank -%}
        <h2 class="section-heading__title h1">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.show_view_all -%}
        <a class="link-arrow" href="{{ collection.url | default: routes.all_products_collection_url }}">
          {{- 'collections.general.view_all' | t -}}
          {% render 'icon', name: 'arrow' %}
        </a>
      {%- endif -%}
    </div>

    <ul
      class="product-grid product-grid--{{ section.settings.columns }}{% if section.settings.mobile_scroll %} product-grid--scroll-mobile{% endif %}"
      role="list"
    >
      {%- for product in products limit: limit -%}
        <li class="product-grid__item">
          {% render 'product-card', product: product %}
        </li>
      {%- else -%}
        {%- for i in (1..4) -%}
          <li class="product-grid__item">
            <div class="product-card">
              <div class="product-card__media">{{ 'product-apparel-1' | placeholder_svg_tag: 'product-card__placeholder' }}</div>
              <div class="product-card__info">
                <h3 class="product-card__title">{{ 'products.product.placeholder_title' | t }}</h3>
              </div>
            </div>
          </li>
        {%- endfor -%}
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Featured products",
  "class": "section-featured-collection",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Latest drop"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection",
      "info": "Leave empty to show all products."
    },
    {
      "type": "range",
      "id": "products_to_show",
      "label": "Products to show",
      "min": 2,
      "max": 16,
      "step": 1,
      "default": 8
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns on desktop",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    {
      "type": "checkbox",
      "id": "mobile_scroll",
      "label": "Swipe on mobile",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_view_all",
      "label": "Show \"View all\" link",
      "default": true
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colors",
      "options": [
        { "value": "default", "label": "Light" },
        { "value": "inverse", "label": "Dark" }
      ],
      "default": "default"
    }
  ],
  "presets": [
    {
      "name": "Featured products"
    }
  ]
}
{% endschema %}
