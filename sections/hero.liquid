{%- liquid
  assign image = section.settings.image
  assign mobile_image = section.settings.image_mobile | default: image
  assign overlay = section.settings.overlay | divided_by: 100.0
-%}

<section
  class="hero hero--{{ section.settings.height }} hero--align-{{ section.settings.alignment }}"
  style="--hero-overlay: {{ overlay }};"
  aria-label="{{ section.settings.heading | strip_html | escape }}"
>
  <div class="hero__media">
    {%- if image != blank -%}
      <picture>
        {%- if section.settings.image_mobile != blank -%}
          <source
            media="(max-width: 749px)"
            srcset="{{ mobile_image | image_url: width: 750 }} 750w, {{ mobile_image | image_url: width: 1100 }} 1100w"
            sizes="100vw"
          >
        {%- endif -%}
        {{
          image
          | image_url: width: 3000
          | image_tag:
            class: 'hero__image',
            widths: '750, 1100, 1500, 1800, 2200, 3000',
            sizes: '100vw',
            loading: 'eager',
            fetchpriority: 'high',
            alt: image.alt
        }}
      </picture>
    {%- else -%}
      <img
        class="hero__image"
        src="{{ 'hero-default.jpg' | asset_url }}"
        width="2400"
        height="1400"
        alt=""
        loading="eager"
        fetchpriority="high"
      >
    {%- endif -%}
  </div>

  <div class="hero__content page-width">
    {%- if section.settings.eyebrow != blank -%}
      <p class="hero__eyebrow">{{ section.settings.eyebrow }}</p>
    {%- endif -%}
    {%- if section.settings.heading != blank -%}
      <h2 class="hero__heading display">{{ section.settings.heading }}</h2>
    {%- endif -%}
    {%- if section.settings.text != blank -%}
      <p class="hero__text">{{ section.settings.text }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank or section.settings.button_label_2 != blank -%}
      <div class="hero__buttons">
        {%- if section.settings.button_label != blank -%}
          <a
            href="{{ section.settings.button_link | default: routes.all_products_collection_url }}"
            class="button button--light"
          >
            {{- section.settings.button_label -}}
          </a>
        {%- endif -%}
        {%- if section.settings.button_label_2 != blank -%}
          <a
            href="{{ section.settings.button_link_2 | default: routes.collections_url }}"
            class="button button--outline-light"
          >
            {{- section.settings.button_label_2 -}}
          </a>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  {%- if section.settings.show_scroll_hint -%}
    <span class="hero__scroll" aria-hidden="true"></span>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "Hero",
  "class": "section-hero",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image",
      "info": "Landscape photo, at least 2400 x 1400px. Leave empty to use the built-in artwork."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Mobile image",
      "info": "Optional portrait crop for phones."
    },
    {
      "type": "range",
      "id": "overlay",
      "label": "Overlay darkness",
      "min": 0,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 40
    },
    {
      "type": "select",
      "id": "height",
      "label": "Height",
      "options": [
        { "value": "full", "label": "Full screen" },
        { "value": "large", "label": "Large" },
        { "value": "medium", "label": "Medium" }
      ],
      "default": "full"
    },
    {
      "type": "select",
      "id": "alignment",
      "label": "Content alignment",
      "options": [
        { "value": "center", "label": "Center" },
        { "value": "left", "label": "Bottom left" }
      ],
      "default": "center"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Small text above heading",
      "default": "New collection"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Armor for the faithful"
    },
    {
      "type": "text",
      "id": "text",
      "label": "Text",
      "default": "Heavyweight streetwear in black and white."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Shop the drop"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "button_label_2",
      "label": "Second button label"
    },
    {
      "type": "url",
      "id": "button_link_2",
      "label": "Second button link"
    },
    {
      "type": "checkbox",
      "id": "show_scroll_hint",
      "label": "Show scroll hint",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ]
}
{% endschema %}
