{%- liquid
  assign current_variant = product.selected_or_first_available_variant
  assign product_form_id = 'product-form-' | append: section.id
  assign media_count = product.media.size
-%}

<section class="product page-width" data-product-section data-section-id="{{ section.id }}">
  <div class="product__grid">
    <div class="product__media">
      {%- if media_count > 0 -%}
        <ul class="product-gallery{% if media_count <= 2 %} product-gallery--stack{% endif %}" role="list" data-gallery>
          {%- for media in product.media -%}
            <li
              class="product-gallery__item"
              data-media-id="{{ media.id }}"
              {% if forloop.first %}data-first{% endif %}
            >
              {%- case media.media_type -%}
                {%- when 'image' -%}
                  {%- liquid
                    assign loading = 'lazy'
                    if forloop.first
                      assign loading = 'eager'
                    endif
                  -%}
                  <a href="{{ media | image_url: width: 2400 }}" class="product-gallery__zoom" target="_blank" rel="noopener" data-zoom>
                    {{
                      media
                      | image_url: width: 1800
                      | image_tag:
                        class: 'product-gallery__image',
                        widths: '450, 650, 900, 1200, 1500, 1800',
                        sizes: '(min-width: 990px) 60vw, 100vw',
                        loading: loading,
                        alt: media.alt | default: product.title
                    }}
                    <span class="visually-hidden">{{ 'products.product.zoom' | t }}</span>
                  </a>
                {%- when 'external_video' -%}
                  <div class="product-gallery__video">
                    {{ media | external_video_tag: loading: 'lazy' }}
                  </div>
                {%- when 'video' -%}
                  <div class="product-gallery__video">
                    {{ media | video_tag: controls: true, playsinline: true, muted: true, loop: true, preload: 'metadata' }}
                  </div>
                {%- else -%}
                  {{ media | media_tag }}
              {%- endcase -%}
            </li>
          {%- endfor -%}
        </ul>
        {%- if media_count > 1 -%}
          <div class="product-gallery__dots" aria-hidden="true">
            {%- for media in product.media -%}
              <span class="product-gallery__dot{% if forloop.first %} is-active{% endif %}"></span>
            {%- endfor -%}
          </div>
        {%- endif -%}
      {%- else -%}
        <div class="product-gallery__placeholder">{{ 'product-apparel-1' | placeholder_svg_tag }}</div>
      {%- endif -%}
    </div>

    <div class="product__info">
      <div class="product__info-inner">
        {%- for block in section.blocks -%}
          {%- case block.type -%}
            {%- when '@app' -%}
              {% render block %}

            {%- when 'title' -%}
              <div class="product__title-wrap" {{ block.shopify_attributes }}>
                {%- if block.settings.show_type and product.type != blank -%}
                  <p class="eyebrow">{{ product.type }}</p>
                {%- endif -%}
                <h1 class="product__title">{{ product.title }}</h1>
              </div>

            {%- when 'price' -%}
              <div class="product__price" {{ block.shopify_attributes }} data-product-price>
                {% render 'price', product: product, variant: current_variant, class: 'price--large' %}
                {%- if cart.taxes_included or shop.shipping_policy.body != blank -%}
                  <p class="product__tax">
                    {%- if cart.taxes_included -%}{{ 'products.product.taxes_included' | t }}{%- endif -%}
                    {%- if shop.shipping_policy.body != blank -%}
                      {{ 'products.product.shipping_policy_html' | t: link: shop.shipping_policy.url }}
                    {%- endif -%}
                  </p>
                {%- endif -%}
              </div>

            {%- when 'variant_picker' -%}
              {%- unless product.has_only_default_variant -%}
                <div class="variant-picker" {{ block.shopify_attributes }} data-variant-picker>
                  {%- for option in product.options_with_values -%}
                    <fieldset class="variant-picker__option" data-option-index="{{ forloop.index0 }}">
                      <legend class="variant-picker__legend">
                        {{ option.name }}: <span class="variant-picker__selected" data-selected-value>{{ option.selected_value }}</span>
                      </legend>
                      <div class="variant-picker__values">
                        {%- for value in option.values -%}
                          {%- assign input_id = section.id | append: '-' | append: option.position | append: '-' | append: forloop.index0 -%}
                          <input
                            class="variant-picker__input"
                            type="radio"
                            id="{{ input_id }}"
                            name="{{ section.id }}-option-{{ option.position }}"
                            value="{{ value | escape }}"
                            {% if option.selected_value == value %}checked{% endif %}
                          >
                          <label class="variant-picker__label" for="{{ input_id }}">{{ value }}</label>
                        {%- endfor -%}
                      </div>
                    </fieldset>
                  {%- endfor -%}
                  {%- if block.settings.size_guide_page != blank -%}
                    <details class="size-guide">
                      <summary class="size-guide__toggle">{{ 'products.product.size_guide' | t }}</summary>
                      <div class="rte size-guide__content">{{ block.settings.size_guide_page.content }}</div>
                    </details>
                  {%- endif -%}
                </div>
              {%- endunless -%}

            {%- when 'buy_buttons' -%}
              <div class="product__buy" {{ block.shopify_attributes }}>
                {%- form 'product', product, id: product_form_id, class: 'product-form', novalidate: 'novalidate', data-type: 'product-form' -%}
                  <input type="hidden" name="id" value="{{ current_variant.id }}" data-variant-id>
                  <div class="product-form__row">
                    <div class="quantity" data-quantity>
                      <button type="button" class="quantity__button" data-quantity-step="-1">
                        <span class="visually-hidden">{{ 'products.product.quantity_decrease' | t }}</span>
                        {% render 'icon', name: 'minus' %}
                      </button>
                      <label class="visually-hidden" for="Quantity-{{ section.id }}">{{ 'products.product.quantity' | t }}</label>
                      <input
                        class="quantity__input"
                        type="number"
                        id="Quantity-{{ section.id }}"
                        name="quantity"
                        value="1"
                        min="1"
                        inputmode="numeric"
                      >
                      <button type="button" class="quantity__button" data-quantity-step="1">
                        <span class="visually-hidden">{{ 'products.product.quantity_increase' | t }}</span>
                        {% render 'icon', name: 'plus' %}
                      </button>
                    </div>
                    <button
                      type="submit"
                      name="add"
                      class="button button--dark button--full product-form__submit"
                      data-add-to-cart
                      {% unless current_variant.available %}disabled{% endunless %}
                    >
                      <span data-add-to-cart-text>
                        {%- if current_variant.available -%}
                          {{ 'products.product.add_to_cart' | t }}
                        {%- else -%}
                          {{ 'products.product.sold_out' | t }}
                        {%- endif -%}
                      </span>
                    </button>
                  </div>
                  {%- if block.settings.show_dynamic_checkout -%}
                    <div class="product-form__checkout">{{ form | payment_button }}</div>
                  {%- endif -%}
                  <p class="form-message form-message--error" role="alert" data-form-error hidden></p>
                {%- endform -%}
              </div>

            {%- when 'description' -%}
              {%- if product.description != blank -%}
                <div class="product__description rte" {{ block.shopify_attributes }}>
                  {{ product.description }}
                </div>
              {%- endif -%}

            {%- when 'collapsible_tab' -%}
              {%- if block.settings.content != blank or block.settings.page != blank -%}
                <details class="accordion" {{ block.shopify_attributes }}>
                  <summary class="accordion__summary">
                    {{ block.settings.heading }}
                    {% render 'icon', name: 'plus' %}
                  </summary>
                  <div class="accordion__content rte">
                    {{ block.settings.content }}
                    {{ block.settings.page.content }}
                  </div>
                </details>
              {%- endif -%}

            {%- when 'text' -%}
              <div class="product__text rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>

            {%- when 'share' -%}
              <div class="product__share" {{ block.shopify_attributes }}>
                <button
                  type="button"
                  class="link-underline"
                  data-share
                  data-share-url="{{ request.origin }}{{ product.url }}"
                  data-share-title="{{ product.title | escape }}"
                >
                  {{ 'products.product.share' | t }}
                </button>
              </div>
          {%- endcase -%}
        {%- endfor -%}
      </div>
    </div>
  </div>

  <script type="application/json" data-product-json>
    {{ product | json }}
  </script>
</section>

{%- comment -%} Structured data for search engines {%- endcomment -%}
<script type="application/ld+json">
  {
    "@context": "https://schema.org/",
    "@type": "Product",
    "name": {{ product.title | json }},
    "url": {{ request.origin | append: product.url | json }},
    {%- if product.featured_image -%}
      "image": [{{ product.featured_image | image_url: width: 1200 | prepend: 'https:' | json }}],
    {%- endif -%}
    "description": {{ product.description | strip_html | strip | truncate: 500 | json }},
    {%- if current_variant.sku != blank -%}
      "sku": {{ current_variant.sku | json }},
    {%- endif -%}
    "brand": { "@type": "Brand", "name": {{ product.vendor | default: shop.name | json }} },
    "offers": [
      {%- for variant in product.variants -%}
        {
          "@type": "Offer",
          {%- if variant.sku != blank -%}"sku": {{ variant.sku | json }},{%- endif -%}
          "availability": "http://schema.org/{% if variant.available %}InStock{% else %}OutOfStock{% endif %}",
          "price": {{ variant.price | divided_by: 100.0 | json }},
          "priceCurrency": {{ cart.currency.iso_code | json }},
          "url": {{ request.origin | append: variant.url | json }}
        }{% unless forloop.last %},{% endunless %}
      {%- endfor -%}
    ]
  }
</script>

{% schema %}
{
  "name": "Product",
  "class": "section-main-product",
  "blocks": [
    { "type": "@app" },
    {
      "type": "title",
      "name": "Title",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_type",
          "label": "Show product type",
          "default": true
        }
      ]
    },
    { "type": "price", "name": "Price", "limit": 1 },
    {
      "type": "variant_picker",
      "name": "Variant picker",
      "limit": 1,
      "settings": [
        {
          "type": "page",
          "id": "size_guide_page",
          "label": "Size guide page",
          "info": "Shows a size guide link under the options."
        }
      ]
    },
    {
      "type": "buy_buttons",
      "name": "Buy buttons",
      "limit": 1,
      "settings": [
        {
          "type": "checkbox",
          "id": "show_dynamic_checkout",
          "label": "Show dynamic checkout buttons",
          "default": true
        }
      ]
    },
    { "type": "description", "name": "Description", "limit": 1 },
    {
      "type": "collapsible_tab",
      "name": "Collapsible tab",
      "settings": [
        {
          "type": "text",
          "id": "heading",
          "label": "Heading",
          "default": "Details"
        },
        {
          "type": "richtext",
          "id": "content",
          "label": "Content"
        },
        {
          "type": "page",
          "id": "page",
          "label": "Content from page"
        }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        {
          "type": "richtext",
          "id": "text",
          "label": "Text",
          "default": "<p>Text block</p>"
        }
      ]
    },
    { "type": "share", "name": "Share", "limit": 1 }
  ]
}
{% endschema %}
