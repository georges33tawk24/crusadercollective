<section class="collection" data-collection-section>
  <header class="collection-hero{% if section.settings.show_image and collection.image %} collection-hero--image color-inverse{% endif %}">
    {%- if section.settings.show_image and collection.image -%}
      <div class="collection-hero__media">
        {{
          collection.image
          | image_url: width: 2400
          | image_tag: class: 'collection-hero__image', widths: '750, 1100, 1500, 2000, 2400', sizes: '100vw', loading: 'eager', alt: ''
        }}
      </div>
    {%- endif -%}
    <div class="page-width collection-hero__content">
      <nav class="breadcrumbs" aria-label="{{ 'general.breadcrumbs.label' | t }}">
        <a href="{{ routes.root_url }}">{{ 'general.breadcrumbs.home' | t }}</a>
        <span aria-hidden="true">/</span>
        <a href="{{ routes.collections_url }}">{{ 'collections.general.title' | t }}</a>
      </nav>
      <h1 class="collection-hero__title display">{{ collection.title }}</h1>
      {%- if section.settings.show_description and collection.description != blank -%}
        <div class="collection-hero__description rte">{{ collection.description }}</div>
      {%- endif -%}
    </div>
  </header>

  <div class="page-width">
    {%- paginate collection.products by section.settings.products_per_page -%}
      {%- if section.settings.enable_filtering or section.settings.enable_sorting -%}
        {%- liquid
          assign clear_url = collection.url
          if collection.sort_by != blank
            assign clear_url = collection.url | append: '?sort_by=' | append: collection.sort_by
          endif
        -%}
        {% render 'facets',
          results: collection,
          clear_url: clear_url,
          enable_filter: section.settings.enable_filtering,
          enable_sort: section.settings.enable_sorting,
          product_count: collection.products_count
        %}
      {%- endif -%}

      {%- if collection.products.size > 0 -%}
        <ul class="product-grid product-grid--{{ section.settings.columns }}" role="list">
          {%- for product in collection.products -%}
            {%- assign lazy = true -%}
            {%- if forloop.index <= 4 -%}{%- assign lazy = false -%}{%- endif -%}
            <li class="product-grid__item">{% render 'product-card', product: product, lazy: lazy %}</li>
          {%- endfor -%}
        </ul>
      {%- else -%}
        <div class="empty-state">
          <p class="h2">{{ 'collections.general.no_matches' | t }}</p>
          <a href="{{ collection.url }}" class="button button--dark">{{ 'collections.filters.clear_all' | t }}</a>
        </div>
      {%- endif -%}

      {% render 'pagination', paginate: paginate %}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Collection",
  "class": "section-main-collection",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_image",
      "label": "Show collection image as banner",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "show_description",
      "label": "Show collection description",
      "default": true
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products per page",
      "min": 8,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "select",
      "id": "columns",
      "label": "Columns on desktop",
      "options": [
        { "value": "3", "label": "3" },
        { "value": "4", "label": "4" }
      ],
      "default": "4"
    },
    {
      "type": "checkbox",
      "id": "enable_filtering",
      "label": "Enable filtering",
      "info": "Manage filters with the Search & Discovery app.",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "enable_sorting",
      "label": "Enable sorting",
      "default": true
    }
  ]
}
{% endschema %}
