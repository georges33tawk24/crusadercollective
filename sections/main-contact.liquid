<section class="section page-width page-width--narrow contact">
  <h1 class="main-page__title display">{{ page.title }}</h1>
  {%- if page.content != blank -%}
    <div class="rte contact__intro">{{ page.content }}</div>
  {%- endif -%}

  {%- form 'contact', id: 'ContactForm', class: 'contact__form' -%}
    {%- if form.posted_successfully? -%}
      <p class="form-message form-message--success" role="status" tabindex="-1" autofocus>
        {% render 'icon', name: 'check' %}
        {{ 'contact.form.success' | t }}
      </p>
    {%- elsif form.errors -%}
      <div class="form-message form-message--error" role="alert" tabindex="-1" autofocus>
        {{ form.errors | default_errors }}
      </div>
    {%- endif -%}
    <div class="field-row">
      <div class="field">
        <label for="ContactForm-name">{{ 'contact.form.name' | t }}</label>
        <input id="ContactForm-name" type="text" name="contact[{{ 'contact.form.name' | t }}]" autocomplete="name" value="{{ form.name }}">
      </div>
      <div class="field">
        <label for="ContactForm-email">{{ 'contact.form.email' | t }} <span aria-hidden="true">*</span></label>
        <input id="ContactForm-email" type="email" name="contact[email]" autocomplete="email" value="{{ form.email }}" required>
      </div>
    </div>
    <div class="field">
      <label for="ContactForm-phone">{{ 'contact.form.phone' | t }}</label>
      <input id="ContactForm-phone" type="tel" name="contact[{{ 'contact.form.phone' | t }}]" autocomplete="tel" value="{{ form.phone }}">
    </div>
    <div class="field">
      <label for="ContactForm-body">{{ 'contact.form.comment' | t }}</label>
      <textarea id="ContactForm-body" name="contact[{{ 'contact.form.comment' | t }}]" rows="6">{{ form.body }}</textarea>
    </div>
    <button type="submit" class="button button--dark">{{ 'contact.form.send' | t }}</button>
  {%- endform -%}
</section>

{% schema %}
{
  "name": "Contact form",
  "class": "section-main-contact",
  "settings": []
}
{% endschema %}
