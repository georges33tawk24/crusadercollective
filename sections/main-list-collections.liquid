<section class="section page-width list-collections">
  <div class="section-heading">
    <h1 class="section-heading__title display">{{ section.settings.heading | default: page_title }}</h1>
  </div>
  <ul class="category-grid__list category-grid__list--3" role="list">
    {%- for collection in collections -%}
      {%- if collection.products_count > 0 -%}
        {%- assign image = collection.featured_image | default: collection.image -%}
        <li class="category-card">
          <a href="{{ collection.url }}" class="category-card__link">
            <div class="category-card__media">
              {%- if image -%}
                {{ image | image_url: width: 1200 | image_tag: class: 'category-card__image', widths: '360, 540, 720, 900, 1200', sizes: '(min-width: 750px) 33vw, 100vw', loading: 'lazy', alt: collection.title }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'category-card__placeholder' }}
              {%- endif -%}
            </div>
            <div class="category-card__label">
              <span class="category-card__title">{{ collection.title }}</span>
              <span class="category-card__count">{{ 'collections.general.items' | t: count: collection.products_count }}</span>
              <span class="category-card__arrow">{% render 'icon', name: 'arrow' %}</span>
            </div>
          </a>
        </li>
      {%- endif -%}
    {%- endfor -%}
  </ul>
</section>

{% schema %}
{
  "name": "Collections list",
  "class": "section-main-list-collections",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Collections"
    }
  ]
}
{% endschema %}
