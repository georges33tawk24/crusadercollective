<section class="password color-inverse">
  <div class="password__inner">
    <div class="password__logo">
      {%- if settings.logo != blank -%}
        {{ settings.logo | image_url: width: 300 | image_tag: alt: shop.name }}
      {%- else -%}
        {% render 'logo-mark' %}
      {%- endif -%}
    </div>
    <h1 class="display password__title">{{ section.settings.heading }}</h1>
    {%- if shop.password_message != blank -%}
      <p class="password__message">{{ shop.password_message }}</p>
    {%- endif -%}
    {% render 'newsletter-form', form_id: 'PasswordNewsletter', inverse: true %}

    <details class="password__login">
      <summary class="link-underline">{{ 'general.password_page.login_link' | t }}</summary>
      {%- form 'storefront_password', class: 'password__form' -%}
        <label class="visually-hidden" for="Password">{{ 'general.password_page.password' | t }}</label>
        <div class="newsletter-form__field newsletter-form__field--inverse">
          <input
            type="password"
            name="password"
            id="Password"
            class="newsletter-form__input"
            autocomplete="current-password"
            placeholder="{{ 'general.password_page.password' | t }}"
            {% if form.errors %}aria-invalid="true"{% endif %}
          >
          <button type="submit" class="newsletter-form__button">
            <span class="visually-hidden">{{ 'general.password_page.enter' | t }}</span>
            {% render 'icon', name: 'arrow' %}
          </button>
        </div>
        {%- if form.errors -%}
          <p class="form-message form-message--error" role="alert">{{ form.errors | default_errors }}</p>
        {%- endif -%}
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "Password",
  "class": "section-main-password",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Something new is coming"
    }
  ]
}
{% endschema %}
