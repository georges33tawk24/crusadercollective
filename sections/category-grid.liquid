<section class="section category-grid color-{{ section.settings.color_scheme }}">
  <div class="page-width">
    <div class="section-heading">
      {%- if section.settings.heading != blank -%}
        <h2 class="section-heading__title h1">{{ section.settings.heading }}</h2>
      {%- endif -%}
      {%- if section.settings.link_label != blank -%}
        <a class="link-arrow" href="{{ section.settings.link | default: routes.collections_url }}">
          {{- section.settings.link_label -}}
          {% render 'icon', name: 'arrow' %}
        </a>
      {%- endif -%}
    </div>

    <ul
      class="category-grid__list category-grid__list--{{ section.blocks.size | at_most: 5 }}"
      role="list"
    >
      {%- for block in section.blocks -%}
        {%- liquid
          assign collection = block.settings.collection
          assign image = block.settings.image | default: collection.featured_image | default: collection.image
          assign title = block.settings.title | default: collection.title
          assign url = collection.url | default: routes.collections_url
        -%}
        <li class="category-card" {{ block.shopify_attributes }}>
          <a href="{{ url }}" class="category-card__link">
            <div class="category-card__media">
              {%- if image != blank -%}
                {{
                  image
                  | image_url: width: 1200
                  | image_tag:
                    class: 'category-card__image',
                    widths: '360, 540, 720, 900, 1200',
                    sizes: '(min-width: 990px) 25vw, (min-width: 750px) 33vw, 80vw',
                    loading: 'lazy',
                    alt: title
                }}
              {%- else -%}
                {{ 'collection-1' | placeholder_svg_tag: 'category-card__placeholder' }}
              {%- endif -%}
            </div>
            <div class="category-card__label">
              <span class="category-card__title">{{ title | default: 'Collection' }}</span>
              {%- if collection.products_count > 0 -%}
                <span class="category-card__count">{{ 'collections.general.items' | t: count: collection.products_count }}</span>
              {%- endif -%}
              <span class="category-card__arrow">{% render 'icon', name: 'arrow' %}</span>
            </div>
          </a>
        </li>
      {%- endfor -%}
    </ul>
  </div>
</section>

{% schema %}
{
  "name": "Shop by category",
  "class": "section-category-grid",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Shop by category"
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "View all"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Link"
    },
    {
      "type": "select",
      "id": "color_scheme",
      "label": "Colors",
      "options": [
        { "value": "default", "label": "Light" },
        { "value": "inverse", "label": "Dark" }
      ],
      "default": "default"
    }
  ],
  "blocks": [
    {
      "type": "category",
      "name": "Category",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Collection"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "info": "Defaults to the collection title."
        },
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image",
          "info": "Defaults to the collection image."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Shop by category",
      "blocks": [
        { "type": "category" },
        { "type": "category" },
        { "type": "category" },
        { "type": "category" }
      ]
    }
  ]
}
{% endschema %}
