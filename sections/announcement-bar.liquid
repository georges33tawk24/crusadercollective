{%- if section.blocks.size > 0 -%}
  <div class="announcement-bar" role="region" aria-label="{{ 'general.announcement' | t }}">
    <div class="announcement-bar__track{% if section.settings.scroll %} announcement-bar__track--scroll{% endif %}">
      {%- assign loops = 1 -%}
      {%- if section.settings.scroll -%}{%- assign loops = 4 -%}{%- endif -%}
      {%- for i in (1..loops) -%}
        <div class="announcement-bar__group"{% if forloop.index > 1 %} aria-hidden="true"{% endif %}>
          {%- for block in section.blocks -%}
            <p class="announcement-bar__message" {{ block.shopify_attributes }}>
              {%- if block.settings.link != blank -%}
                <a href="{{ block.settings.link }}"{% if forloop.parentloop.index > 1 %} tabindex="-1"{% endif %}>{{ block.settings.text }}</a>
              {%- else -%}
                {{ block.settings.text }}
              {%- endif -%}
            </p>
            <span class="announcement-bar__sep" aria-hidden="true">✚</span>
          {%- endfor -%}
        </div>
      {%- endfor -%}
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement bar",
  "class": "section-announcement",
  "enabled_on": {
    "groups": ["header"]
  },
  "max_blocks": 6,
  "settings": [
    {
      "type": "checkbox",
      "id": "scroll",
      "label": "Scroll messages",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "New drop is live"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement bar",
      "blocks": [{ "type": "announcement" }]
    }
  ]
}
{% endschema %}
