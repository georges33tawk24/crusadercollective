<section class="section page-width blog">
  <div class="section-heading">
    <h1 class="section-heading__title display">{{ blog.title }}</h1>
  </div>
  {%- paginate blog.articles by 12 -%}
    <ul class="blog__grid" role="list">
      {%- for article in blog.articles -%}
        <li>
          <a href="{{ article.url }}" class="article-card">
            <div class="article-card__media">
              {%- if article.image -%}
                {{ article.image | image_url: width: 1000 | image_tag: widths: '400, 600, 800, 1000', sizes: '(min-width: 750px) 33vw, 100vw', loading: 'lazy', alt: article.image.alt }}
              {%- endif -%}
            </div>
            <p class="eyebrow">{{ article.published_at | time_tag: format: 'date' }}</p>
            <h2 class="article-card__title">{{ article.title }}</h2>
            <p class="article-card__excerpt">{{ article.excerpt_or_content | strip_html | truncatewords: 24 }}</p>
          </a>
        </li>
      {%- endfor -%}
    </ul>
    {% render 'pagination', paginate: paginate %}
  {%- endpaginate -%}
</section>

{% schema %}
{
  "name": "Blog posts",
  "class": "section-main-blog",
  "settings": []
}
{% endschema %}
