<footer class="footer color-inverse">
  <div class="page-width">
    <div class="footer__top">
      <div class="footer__brand">
        <a href="{{ routes.root_url }}" class="footer__logo">
          {%- if settings.logo != blank -%}
            {{ settings.logo | image_url: width: 160 | image_tag: loading: 'lazy', alt: shop.name }}
          {%- else -%}
            {% render 'logo-mark' %}
          {%- endif -%}
        </a>
        {%- if section.settings.heading != blank -%}
          <p class="footer__heading h2">{{ section.settings.heading }}</p>
        {%- endif -%}
        {%- if section.settings.text != blank -%}
          <div class="footer__text rte">{{ section.settings.text }}</div>
        {%- endif -%}
        {% render 'social-links' %}
      </div>

      {%- for block in section.blocks -%}
        {%- case block.type -%}
          {%- when 'menu' -%}
            <div class="footer__block" {{ block.shopify_attributes }}>
              {%- if block.settings.title != blank -%}
                <h2 class="footer__block-title">{{ block.settings.title }}</h2>
              {%- endif -%}
              <ul class="footer__links" role="list">
                {%- for link in block.settings.menu.links -%}
                  <li><a href="{{ link.url }}" class="footer__link">{{ link.title }}</a></li>
                {%- endfor -%}
              </ul>
            </div>
          {%- when 'newsletter' -%}
            <div class="footer__block footer__block--newsletter" {{ block.shopify_attributes }}>
              {%- if block.settings.title != blank -%}
                <h2 class="footer__block-title">{{ block.settings.title }}</h2>
              {%- endif -%}
              {%- if block.settings.text != blank -%}
                <p class="footer__small">{{ block.settings.text }}</p>
              {%- endif -%}
              {% render 'newsletter-form', form_id: 'FooterNewsletter', inverse: true %}
            </div>
        {%- endcase -%}
      {%- endfor -%}
    </div>

    <div class="footer__bottom">
      <p class="footer__small">
        &copy; {{ 'now' | date: '%Y' }} {{ shop.name | link_to: routes.root_url }}
        {%- if section.settings.show_policies -%}
          {%- for policy in shop.policies -%}
            {%- if policy != blank -%}
              <span aria-hidden="true"> · </span><a href="{{ policy.url }}">{{ policy.title }}</a>
            {%- endif -%}
          {%- endfor -%}
        {%- endif -%}
      </p>
      {%- if section.settings.show_payment_icons and shop.enabled_payment_types.size > 0 -%}
        <ul class="footer__payments" role="list">
          {%- for type in shop.enabled_payment_types -%}
            <li>{{ type | payment_type_svg_tag: class: 'footer__payment-icon' }}</li>
          {%- endfor -%}
        </ul>
      {%- endif -%}
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "class": "section-footer",
  "enabled_on": {
    "groups": ["footer"]
  },
  "max_blocks": 4,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Wear your faith boldly."
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Text",
      "default": "<p>Streetwear for believers. Designed in black and white.</p>"
    },
    {
      "type": "checkbox",
      "id": "show_policies",
      "label": "Show policy links",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_payment_icons",
      "label": "Show payment icons",
      "default": true
    }
  ],
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Shop"
        },
        {
          "type": "link_list",
          "id": "menu",
          "label": "Menu",
          "default": "footer"
        }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "limit": 1,
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Heading",
          "default": "Join the collective"
        },
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "Early access to new drops. No spam."
        }
      ]
    }
  ]
}
{% endschema %}
